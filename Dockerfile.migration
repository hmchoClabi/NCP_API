FROM postgres:16@sha256:ca0bd484cb98bf4b24eb1010e73fb3fcbd6714d240fbc1a10eea5b7dbecb641d

LABEL org.opencontainers.image.source="NCP SourceCommit architect_report"

COPY database/schema /schema
COPY deploy/docker/migrate.sh /migration/migrate.sh

ENTRYPOINT ["/bin/sh", "/migration/migrate.sh"]
CMD ["migrate"]
