# Copy this file to deploy/private/.env.k8s and replace every value.
# The destination is Git-ignored. Do not commit actual credentials.
DB_ADMIN_USER=ncp_admin
DB_ADMIN_PASSWORD=REPLACE_WITH_RANDOM_VALUE
DB_CONTROL_APP_PASSWORD=REPLACE_WITH_RANDOM_VALUE
DB_PUBLIC_WORKER_PASSWORD=REPLACE_WITH_RANDOM_VALUE
DB_GOV_WORKER_PASSWORD=REPLACE_WITH_RANDOM_VALUE
DB_MSP_APP_PASSWORD=REPLACE_WITH_RANDOM_VALUE
WEB_SECRET_KEY=REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES
# Optional NAVER WORKS SMTP settings. SMTP_FROM must be authorized for the user.
SMTP_HOST=smtp.worksmobile.com
SMTP_PORT=587
SMTP_FROM=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_USE_SSL=false
