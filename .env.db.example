# Local PostgreSQL development settings. Copy to .env.db before manual use.
# setup_database.ps1 creates .env.db with random passwords when it is absent.
POSTGRES_VERSION=16
REPORT_DB_ENABLED=true
REPORT_DB_REQUIRED=true
REPORT_DB_ROLE=msp
REPORT_DB_SSLMODE=disable
DB_HOST=127.0.0.1
DB_PORT=55432
DB_NAME=ncp_report
DB_ADMIN_USER=ncp_admin
DB_ADMIN_PASSWORD=replace-with-a-random-local-password
DB_CONTROL_APP_PASSWORD=replace-with-a-random-local-password
DB_PUBLIC_WORKER_PASSWORD=replace-with-a-random-local-password
DB_GOV_WORKER_PASSWORD=replace-with-a-random-local-password
DB_MSP_APP_PASSWORD=replace-with-a-random-local-password
