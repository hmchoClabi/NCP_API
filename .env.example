# NCP report collection
NCP_ACCESS_KEY=
NCP_SECRET_KEY=
NCP_API_TYPE=public
NCP_REGION=KR
NCP_CUSTOMER_ID=customer-001
NCP_CUSTOMER_NAME=Example Customer
# Reserved for a future DB/KMS-backed credential provider.
NCP_CREDENTIAL_REF=

# Optional PostgreSQL report persistence. Local development reads the
# Git-ignored .env.db created by setup_database.cmd. In NKS, inject
# REPORT_DATABASE_URL from a Kubernetes Secret instead.
REPORT_DB_ENABLED=false
REPORT_DB_REQUIRED=true
REPORT_DB_CONFIG_FILE=.env.db
REPORT_DB_ROLE=msp
# REPORT_DATABASE_URL=postgresql://user:password@host:5432/ncp_report?sslmode=require
REPORT_DB_SSLMODE=disable
REPORT_DB_CONNECT_TIMEOUT=10

# Optional SMTP report delivery
SMTP_HOST=smtp.example.com
SMTP_PORT=587
# This must be an address authorized by the SMTP server. For NAVER WORKS,
# normally use the same full email address as SMTP_USERNAME.
SMTP_FROM=reports@example.com
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SMTP_TIMEOUT=30
REPORT_EMAIL_TO=recipient@example.com
